model Rental {
  id         String @id @default(uuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  providerId  String
  provider    Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quantity    Int

  startDate       DateTime
  endDate         DateTime
  rentalDays      Int
  rentalAmount    Decimal  @db.Decimal(10, 2)
  securityDeposit Decimal  @db.Decimal(10, 2)
  lateFee         Decimal  @default(0) @db.Decimal(10, 2)
  damageCharge    Decimal  @default(0) @db.Decimal(10, 2)

  payments Payment[]

  @@map("rentals")
}
