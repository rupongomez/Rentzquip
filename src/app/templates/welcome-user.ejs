<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to Rentzquip</title>
</head>

<body style="
  margin: 0;
  padding: 0;
  background-color: #f4f7f6;
  font-family: Arial, Helvetica, sans-serif;
  color: #1f2937;
">

    <table width="100%" cellpadding="0" cellspacing="0" border="0"
        style="background-color: #f4f7f6; padding: 40px 15px;">
        <tr>
            <td align="center">

                <!-- Main Container -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
            max-width: 560px;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #e5e7eb;
          ">

                    <!-- Header -->
                    <tr>
                        <td style="
                padding: 28px 30px;
                text-align: center;
                background-color: #111827;
              ">
                            <div style="
                font-size: 28px;
                font-weight: 700;
                color: #ffffff;
                letter-spacing: -0.5px;
              ">
                                Rentzquip
                            </div>

                            <div style="
                margin-top: 6px;
                font-size: 13px;
                color: #d1d5db;
              ">
                                Share. Rent. Get things done.
                            </div>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px 35px 35px; text-align: center;">

                            <!-- Success Icon -->
                            <div style="
                width: 64px;
                height: 64px;
                margin: 0 auto 22px;
                background-color: #ecfdf5;
                border-radius: 50%;
                line-height: 64px;
                font-size: 30px;
              ">
                                ✓
                            </div>

                            <h1 style="
                margin: 0 0 12px;
                font-size: 25px;
                line-height: 1.3;
                color: #111827;
              ">
                                Welcome to Rentzquip!
                            </h1>

                            <p style="
                margin: 0 0 25px;
                font-size: 15px;
                line-height: 1.7;
                color: #4b5563;
              ">
                                Hi <%= name %>,
                            </p>

                            <p style="
                margin: 0 0 22px;
                font-size: 15px;
                line-height: 1.7;
                color: #4b5563;
              ">
                                Your account has been successfully created and your email
                                address has been verified.
                            </p>

                            <p style="
                margin: 0 0 28px;
                font-size: 15px;
                line-height: 1.7;
                color: #4b5563;
              ">
                                You're now ready to discover equipment, rent what you need,
                                or share your own equipment with the Rentzquip community.
                            </p>

                            <!-- Account Ready Box -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 28px;">
                                <tr>
                                    <td style="
                    background-color: #f9fafb;
                    border: 1px solid #e5e7eb;
                    border-radius: 10px;
                    padding: 20px;
                    text-align: left;
                  ">

                                        <p style="
                      margin: 0 0 10px;
                      font-size: 13px;
                      font-weight: 600;
                      color: #6b7280;
                      text-transform: uppercase;
                      letter-spacing: 0.5px;
                    ">
                                            Your account is ready
                                        </p>

                                        <p style="
                      margin: 0;
                      font-size: 14px;
                      line-height: 1.6;
                      color: #374151;
                    ">
                                            Start exploring available equipment and find the
                                            right tools for your next project.
                                        </p>

                                    </td>
                                </tr>
                            </table>

                            <!-- CTA -->
                            <a href="<%= loginUrl %>" style="
                  display: inline-block;
                  padding: 13px 28px;
                  background-color: #111827;
                  color: #ffffff;
                  text-decoration: none;
                  border-radius: 8px;
                  font-size: 14px;
                  font-weight: 600;
                ">
                                Start Exploring
                            </a>

                            <p style="
                margin: 28px 0 0;
                font-size: 13px;
                line-height: 1.6;
                color: #9ca3af;
              ">
                                We're glad to have you with us.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="
              padding: 22px 30px;
              background-color: #f9fafb;
              border-top: 1px solid #e5e7eb;
              text-align: center;
            ">

                            <p style="
                margin: 0 0 6px;
                font-size: 12px;
                color: #6b7280;
              ">
                                © <%= new Date().getFullYear() %> Rentzquip. All rights reserved.
                            </p>

                            <p style="
                margin: 0;
                font-size: 12px;
                color: #9ca3af;
              ">
                                Equipment sharing made simple.
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>