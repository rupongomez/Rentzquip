<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Email - Rentzquip</title>
</head>

<body style="
  margin: 0;
  padding: 0;
  background-color: #f4f7f6;
  font-family: Arial, Helvetica, sans-serif;
  color: #1f2937;
">

    <table width="100%" cellpadding="0" cellspacing="0" border="0"
        style="background-color: #f4f7f6; padding: 40px 15px;">
        <tr>
            <td align="center">

                <!-- Main Container -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
            max-width: 560px;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #e5e7eb;
          ">

                    <!-- Header -->
                    <tr>
                        <td style="
                padding: 28px 30px;
                text-align: center;
                background-color: #111827;
              ">
                            <div style="
                font-size: 28px;
                font-weight: 700;
                color: #ffffff;
                letter-spacing: -0.5px;
              ">
                                Rentzquip
                            </div>

                            <div style="
                margin-top: 6px;
                font-size: 13px;
                color: #d1d5db;
              ">
                                Share. Rent. Get things done.
                            </div>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px 35px 35px;">

                            <h1 style="
                margin: 0 0 12px;
                font-size: 24px;
                line-height: 1.3;
                color: #111827;
              ">
                                Verify your email
                            </h1>

                            <p style="
                margin: 0 0 24px;
                font-size: 15px;
                line-height: 1.7;
                color: #4b5563;
              ">
                                Hi <%= name %>,
                            </p>

                            <p style="
                margin: 0 0 25px;
                font-size: 15px;
                line-height: 1.7;
                color: #4b5563;
              ">
                                Thanks for signing up for Rentzquip. Please use the
                                verification code below to confirm your email address.
                            </p>

                            <!-- OTP Box -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 10px 0 25px;">
                                <tr>
                                    <td align="center" style="
                      background-color: #f3f4f6;
                      border: 1px dashed #9ca3af;
                      border-radius: 10px;
                      padding: 22px 15px;
                    ">
                                        <div style="
                      font-size: 12px;
                      font-weight: 600;
                      color: #6b7280;
                      text-transform: uppercase;
                      letter-spacing: 1.5px;
                      margin-bottom: 8px;
                    ">
                                            Verification Code
                                        </div>

                                        <div style="
                      font-size: 32px;
                      font-weight: 700;
                      letter-spacing: 8px;
                      color: #111827;
                    ">
                                            <%= otp %>
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <p style="
                margin: 0 0 8px;
                font-size: 14px;
                line-height: 1.6;
                color: #4b5563;
                text-align: center;
              ">
                                This code will expire in <strong>
                                    <%= expirationMinutes %> minutes
                                </strong>.
                            </p>

                            <p style="
                margin: 25px 0 0;
                font-size: 14px;
                line-height: 1.6;
                color: #6b7280;
              ">
                                If you didn't create a Rentzquip account, you can safely
                                ignore this email.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="
              padding: 22px 30px;
              background-color: #f9fafb;
              border-top: 1px solid #e5e7eb;
              text-align: center;
            ">

                            <p style="
                margin: 0 0 6px;
                font-size: 12px;
                color: #6b7280;
              ">
                                © <%= new Date().getFullYear() %> Rentzquip. All rights reserved.
                            </p>

                            <p style="
                margin: 0;
                font-size: 12px;
                color: #9ca3af;
              ">
                                Equipment sharing made simple.
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>